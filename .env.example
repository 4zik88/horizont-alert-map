# ─── Ingest ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# Required. Postgres connection string — a secret: it carries the password, and the
# worker never logs it. Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgres://horizont@127.0.0.1:5544/horizont

CHANNELS=kpszsu,KozakChornobay,sectorv666,monikppy
POLL_INTERVAL_MS=20000
POLL_JITTER_PCT=0.15
FETCH_TIMEOUT_MS=10000
MAX_BACKOFF_MS=300000
GAP_FILL_MAX_PAGES=25

# ─── Parser ──────────────────────────────────────────────────────────
PARSE_BATCH_SIZE=200
PARSE_INTERVAL_MS=10000
# Max Claude calls per batch. 0 disables the LLM fallback entirely (rules only).
LLM_BUDGET_PER_BATCH=20
# Fallback provider for messages the rules cannot resolve.
# 'auto' = Groq if GROQ_API_KEY is set, else Anthropic, else rules-only.
LLM_PROVIDER=auto
LLM_TIMEOUT_MS=20000

# Groq — free tier. Create a key at https://console.groq.com/keys
# Run `pnpm llm:check` to list the models your key can actually use.
# GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b

# Anthropic — paid alternative, same extraction contract.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ─── Telegram bot ────────────────────────────────────────────────────
# Without a token the bot and notifier do not start; ingest and parsing continue.
# Create a bot with @BotFather, then run `pnpm bot:check`.
# TELEGRAM_BOT_TOKEN=

# Closed access. An EMPTY allowlist admits nobody, not everybody.
# ALLOWED_CHAT_IDS=123456789
# ALLOWED_USERNAMES=@yourname
BOT_POLL_TIMEOUT_SECONDS=30

# Notification tuning. Lower confidence or a longer lead means more warnings and
# more false alarms; a muted bot is worse than no bot.
NOTIFY_INTERVAL_MS=15000
NOTIFY_COOLDOWN_MS=300000
NOTIFY_MIN_CONFIDENCE=0.6
NOTIFY_MAX_AGE_MS=1800000
NOTIFY_COURSE_TOLERANCE_DEG=30
NOTIFY_LEAD_MINUTES=25

# ─── Air-raid alerts ─────────────────────────────────────────────────────────
# Works with NO token: the default is alerts.in.ua's public situation report.
# 'auto' = tokened alerts.in.ua if a token is set, else the public report.
ALERTS_PROVIDER=auto
# ALERTS_IN_UA_TOKEN=
ALERTS_POLL_INTERVAL_MS=15000

# ─── Map ─────────────────────────────────────────────────────────────────────
# Worker: where the map is served. The bot puts a one-time login link to it in the
# /start and /map replies. Without it the bot issues no map logins.
# PUBLIC_URL=https://horizont.example.up.railway.app

# API (apps/api). Railway gives each service its own PORT; locally the API takes
# 8080 (the web dev server proxies to it) and the worker is started with PORT=8081.
HOST=0.0.0.0
# Secure cookies need HTTPS: on by default in production, off for local HTTP.
# COOKIE_SECURE=false
# Built web app, relative to the repo root.
WEB_DIST=apps/web/dist
# A channel that has not polled successfully for this long shows as unhealthy.
SOURCE_STALE_MS=100000

# Maintenance: the ingest log is pruned daily. Backups are Railway Postgres's own.
RETENTION_DAYS=90

# One-off migration from the old SQLite file: `pnpm import:sqlite <path>` copies it
# into the (empty) DATABASE_URL database. The path can also come from here.
# SQLITE_IMPORT_PATH=./data/app.db
