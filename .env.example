# ─── Step 1: ingest ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# Local: ./data/app.db   Railway: /data/app.db (mounted Volume — see README)
DB_PATH=./data/app.db

CHANNELS=kpszsu,KozakChornobay,sectorv666
POLL_INTERVAL_MS=20000
POLL_JITTER_PCT=0.15
FETCH_TIMEOUT_MS=10000
MAX_BACKOFF_MS=300000
GAP_FILL_MAX_PAGES=25

# ─── Step 2: parser ──────────────────────────────────────────────────────────
PARSE_BATCH_SIZE=200
PARSE_INTERVAL_MS=10000
# Max Claude calls per batch. 0 disables the LLM fallback entirely (rules only).
LLM_BUDGET_PER_BATCH=20
# Without a key the parser runs rules-only; unresolved messages go to the feed as text.
# ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Step 3: telegram bot ────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=
# ALLOWED_CHAT_IDS=
# ALLOWED_USERNAMES=

# ─── Step 4: map ─────────────────────────────────────────────────────────────
# ALERTS_IN_UA_TOKEN=
# MAP_TOKEN=
