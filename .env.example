# ─── Step 1: ingest ──────────────────────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=info
PORT=8080

# Local: ./data/app.db   Railway: /data/app.db (mounted Volume — see README)
DB_PATH=./data/app.db

CHANNELS=kpszsu,KozakChornobay,sectorv666
POLL_INTERVAL_MS=20000
POLL_JITTER_PCT=0.15
FETCH_TIMEOUT_MS=10000
MAX_BACKOFF_MS=300000
GAP_FILL_MAX_PAGES=25

# ─── Step 2: parser ──────────────────────────────────────────────────────────
