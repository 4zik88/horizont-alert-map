{
  "name": "horizont",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12 <23"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "dev": "tsx watch --conditions=source --env-file-if-exists=.env apps/worker/src/index.ts",
    "start": "node apps/worker/dist/index.js",
    "backfill": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/backfill.ts",
    "fixtures:refresh": "tsx --conditions=source apps/worker/scripts/refresh-fixtures.ts",
    "build:toponyms": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/build-toponyms.ts",
    "build:raions": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/build-raions.ts",
    "coverage": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/parser-coverage.ts",
    "llm:check": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/llm-check.ts",
    "bot:check": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/bot-check.ts",
    "backup": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/backup.ts",
    "fuzzy:audit": "tsx --conditions=source --env-file-if-exists=.env apps/worker/scripts/fuzzy-audit.ts"
  },
  "devDependencies": {
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
